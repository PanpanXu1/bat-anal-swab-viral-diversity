# Generated outputs follow the policy of each workflow.
# Workflow-specific .gitignore files may exclude generated results.
**/outputs/*
**/results/*

# Non-target image formats
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.svg

# R/Python caches and local environments
.Rhistory
.RData
.Rproj.user/
renv/library/
.r-lib/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.worktrees/
.w/

# Temporary/cache/system files
*.tmp
*.temp
*.log
*.bak
~$*
.DS_Store
Thumbs.db
desktop.ini
